{
  "name": "seleya-bridge-app",
  "productName": "Seleya Bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Menu-bar app that runs seleya-bridge, so Seleya web can reach Claude Code on this Mac",
  "type": "module",
  "main": "dist/main/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/render-icons.mjs && node scripts/build-main.mjs && vite build",
    "start": "electron .",
    "dist": "pnpm build && electron-builder --config electron-builder.config.mjs",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "lucide-react": "1.54.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
